    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tiptap/extension-code-block-lowlight": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/markdown": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@wailsio/runtime": "latest",
    "codemirror": "^6.0.2",
    "lowlight": "^3.3.0",
