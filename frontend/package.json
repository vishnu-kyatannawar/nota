    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.5",
    "vitest": "^4.1.11"
